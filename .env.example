# Настройки k3sctl. Скопируйте в .env (он в .gitignore) и заполните.
# Один .env = один сервер; для другого сервера используйте --env-file.
# Комментарий можно писать после значения, но не после пустого значения:
# «X=   # текст» прочитается как значение «# текст».

# ---------- SSH до сервера ----------
SSH_HOST=1.2.3.4                 # адрес или домен сервера
SSH_PORT=22
SSH_USER=user                    # обычный пользователь с sudo (его заводит k3sctl prepare)
SSH_KEY=~/.ssh/id_ed25519        # приватный ключ для входа
SSH_PUBKEY=~/.ssh/id_ed25519.pub # публичный ключ, который кладём пользователю
# Дополнительные опции ssh одной строкой, напр. "-o ProxyJump=bastion"
SSH_EXTRA_OPTS=

# ---------- k3sctl prepare: подготовка свежего сервера ----------
BOOTSTRAP_USER=root              # под кем заходить на свежий сервер (root или sudo-пользователь провайдера)
PREPARE_UPGRADE=true             # обновить пакеты (apt-get upgrade)
PREPARE_DISABLE_PASSWORD=true    # запретить вход по паролю всем, включая root
SERVER_TIMEZONE=Asia/Almaty      # часовой пояс сервера; пусто = не трогать

# ---------- k3sctl install: установка k3s ----------
K3S_ROLE=server                  # server (master) или agent (worker)
# Версия k3s, напр. v1.33.5+k3s1; пусто = последняя стабильная
K3S_VERSION=
# Домены/IP через запятую, которые попадут в сертификат API; пусто = SSH_HOST. Только для server.
K3S_TLS_SAN=
# Дополнительные аргументы k3s, напр. "--disable traefik"
K3S_EXTRA_ARGS=
# Переменные официального установщика (см. https://get.k3s.io), напр. "INSTALL_K3S_CHANNEL=latest"
K3S_INSTALL_ENV=
# Только для agent: SSH-хост master, с которого читается токен кластера (через sudo)
K3S_SERVER_SSH_HOST=
K3S_SERVER_SSH_PORT=22
# Пользователь SSH на master; пусто = SSH_USER
K3S_SERVER_SSH_USER=
# Адрес API master для agent; пусто = https://K3S_SERVER_SSH_HOST:6443
K3S_SERVER_URL=
# Токен кластера; можно задать явно вместо чтения с master
K3S_TOKEN=

# ---------- k3sctl access: доступ через ServiceAccount ----------
# Адрес API для kubeconfig; пусто = https://SSH_HOST:6443
API_URL=
SA_NAME=mdb-admin                # имя учётки (ServiceAccount)
SA_NAMESPACE=kube-system
CLUSTER_ROLE=cluster-admin       # какую ClusterRole выдать
# Срок токена, напр. 8760h; пусто = бессрочный токен (через секрет)
SA_TOKEN_TTL=
CONTEXT_NAME=my-k3s              # имя контекста в kubeconfig
LOCAL_KUBECONFIG=~/.kube/config
SET_CURRENT_CONTEXT=false        # переключить текущий контекст на новый
