# Настройки скриптов. Скопируйте в .env (он в .gitignore) и заполните.
# Один .env = один сервер; для другого сервера используйте --env-file.

# ---------- SSH до сервера ----------
SSH_HOST=1.2.3.4                 # адрес или домен сервера
SSH_PORT=22
SSH_USER=user                    # обычный пользователь с sudo (его заводит prepare_server.sh)
SSH_KEY=~/.ssh/id_ed25519        # приватный ключ для входа
SSH_PUBKEY=~/.ssh/id_ed25519.pub # публичный ключ, который кладём пользователю
# Дополнительные опции ssh, если нужны (напр. "-o ProxyJump=bastion")
#SSH_EXTRA_OPTS=

# ---------- prepare_server.sh: подготовка свежего сервера ----------
BOOTSTRAP_USER=root              # под кем заходить на свежий сервер (root или sudo-пользователь провайдера)
PREPARE_UPGRADE=true             # обновить пакеты (apt-get upgrade)
PREPARE_DISABLE_PASSWORD=true    # запретить вход по паролю всем, включая root
SERVER_TIMEZONE=Asia/Almaty      # часовой пояс сервера; пусто = не трогать

# ---------- install_k3s.sh: установка k3s ----------
K3S_ROLE=server                  # server (master) или agent (worker)
K3S_VERSION=                     # пусто = последняя стабильная; напр. v1.33.5+k3s1
K3S_TLS_SAN=                     # домены/IP через запятую, которые попадут в сертификат API;
                                 # пусто = SSH_HOST. Только для server.
K3S_EXTRA_ARGS=                  # доп. аргументы k3s, напр. "--disable traefik"
# Только для agent: откуда взять адрес master и токен кластера
K3S_SERVER_SSH_HOST=             # SSH-хост master; токен читается с него через sudo
K3S_SERVER_SSH_PORT=22
K3S_SERVER_SSH_USER=             # пусто = SSH_USER
K3S_SERVER_URL=                  # пусто = https://K3S_SERVER_SSH_HOST:6443
K3S_TOKEN=                       # можно задать явно вместо чтения с master
# Переменные официального установщика (см. https://get.k3s.io), напр.
# "INSTALL_K3S_CHANNEL=latest"
#K3S_INSTALL_ENV=

# ---------- setup_sa_access.sh: доступ через ServiceAccount ----------
API_URL=                         # адрес API для kubeconfig; пусто = https://SSH_HOST:6443
SA_NAME=mdb-admin                # имя учётки (ServiceAccount)
SA_NAMESPACE=kube-system
CLUSTER_ROLE=cluster-admin       # какую ClusterRole выдать
SA_TOKEN_TTL=                    # пусто = бессрочный токен (секрет); иначе срок, напр. 8760h
CONTEXT_NAME=my-k3s              # имя контекста в kubeconfig
LOCAL_KUBECONFIG=~/.kube/config
SET_CURRENT_CONTEXT=false        # переключить текущий контекст на новый
